<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ros2_nav_car">

  <!-- Base footprint (投影到地面的投影点) -->
  <link name="base_footprint"/>

  <!-- Base link (小车机械车身本体) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.25 0.18 0.08"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 0.9"/>
      </material>
    </visual>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
  </joint>

  <!-- 激光雷达组件 (LiDAR Link) -->
  <link name="laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="base_to_laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.08 0 0.08" rpy="0 0 0"/>
  </joint>

</robot>
